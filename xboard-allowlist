#!/bin/bash
# ============================================================================
#  xboard-allowlist —— XBoard 回源端口 IP 白名单管理
#
#  为什么不用 ufw：
#     docker 发布端口时在 iptables nat/PREROUTING 做 DNAT，流量绕过 INPUT 链，
#     ufw 的 allow/deny 对容器端口无效。所以规则必须写在 DOCKER-USER 链上。
#
#  用法：
#     xboard-allowlist              交互菜单
#     xboard-allowlist list         列表 + 生效规则 + 命中计数
#     xboard-allowlist add <地址>   添加 IP 或 CIDR（自动 apply）
#     xboard-allowlist del <序号|地址>  删除（自动 apply）
#     xboard-allowlist apply        按列表重建 iptables 规则
#     xboard-allowlist test         本机连通性自测
#     xboard-allowlist raw          原始 iptables 输出
#
#  文件：
#     /etc/xboard-allowlist/ips.list   放行列表（可手工编辑，一行一个）
#     /var/log/xboard-allowlist.log    变更日志
#     /etc/systemd/system/xboard-allowlist.service   开机自动 apply
# ============================================================================
set +H
set -u

PORT="${XB_PORT:-7001}"
CHAIN="DOCKER-USER"
DIR="/etc/xboard-allowlist"
LIST="$DIR/ips.list"
LOGF="/var/log/xboard-allowlist.log"

if [ -t 1 ]; then
    R=$'\033[31m'; G=$'\033[32m'; Y=$'\033[33m'; C=$'\033[36m'; B=$'\033[1m'; N=$'\033[0m'
else
    R=""; G=""; Y=""; C=""; B=""; N=""
fi

ok()   { printf '%s%s%s\n' "$G" "$*" "$N"; }
warn() { printf '%s%s%s\n' "$Y" "$*" "$N"; }
err()  { printf '%s%s%s\n' "$R" "$*" "$N" >&2; }
log()  { printf '[%s] %s\n' "$(date '+%F %T')" "$*" >> "$LOGF" 2>/dev/null || true; }

# ---------------------------------------------------------------- 基础

need_root() {
    [ "$(id -u)" -eq 0 ] || { err "需要 root 权限"; exit 1; }
}

init_list() {
    mkdir -p "$DIR" 2>/dev/null || true
    chmod 750 "$DIR" 2>/dev/null || true
    if [ ! -f "$LIST" ]; then
        cat > "$LIST" <<'EOL'
# 回源放行列表
# 每行一个 IPv4 地址或 CIDR。下面两条是 RFC 5737 文档保留地址，
# 仅作格式示例，换成你自己的 CDN 回源 IP / 网段：
#   203.0.113.10
#   198.51.100.0/24
# 以 # 开头为注释，空行忽略。序号就是有效行的顺序。
# 添加：xboard-allowlist add <IP>
# 应用：xboard-allowlist apply
EOL
        chmod 640 "$LIST"
        log "init default list"
    fi
}

# 输出有效条目（去注释、去空行）
entries() { grep -vE '^[[:space:]]*(#|$)' "$LIST" 2>/dev/null || true; }

valid_addr() {
    local v="$1" re ip o
    re='^([0-9]{1,3}\.){3}[0-9]{1,3}(/([0-9]|[12][0-9]|3[0-2]))?$'
    [[ "$v" =~ $re ]] || return 1
    ip="${v%%/*}"
    local -a p
    IFS='.' read -ra p <<< "$ip"
    for o in "${p[@]}"; do
        [ "$o" -le 255 ] 2>/dev/null || return 1
    done
    return 0
}

chain_ok() { iptables -S "$CHAIN" >/dev/null 2>&1; }

# 本脚本自己的规则（只认带 --dport $PORT 的）
my_rules() {
    iptables -S "$CHAIN" 2>/dev/null \
        | grep -E -- "--dport ${PORT}([[:space:]]|$)" \
        | grep -vE '^-[NP]' || true
}

# ---------------------------------------------------------------- 规则

flush_rules() {
    local r
    while IFS= read -r r; do
        [ -z "$r" ] && continue
        r="${r/#-A /-D }"
        # 有意不加引号：需要按空格分词交给 iptables
        # shellcheck disable=SC2086
        iptables $r 2>/dev/null || true
    done < <(my_rules)
}

apply_rules() {
    local -a ips=()
    local ip i

    chain_ok || { err "DOCKER-USER 链不存在（docker 没在运行？）"; return 1; }

    while IFS= read -r ip; do
        [ -n "$ip" ] && ips+=("$ip")
    done < <(entries)

    if [ "${#ips[@]}" -eq 0 ]; then
        err "列表为空，拒绝应用 —— 否则 $PORT 会全部封死"
        return 1
    fi

    flush_rules

    if ! iptables -I "$CHAIN" 1 -p tcp --dport "$PORT" -j DROP; then
        err "插入兜底 DROP 失败"
        return 1
    fi

    # 倒着插到位置 1，最终顺序与列表一致
    for (( i=${#ips[@]}-1; i>=0; i-- )); do
        if ! iptables -I "$CHAIN" 1 -p tcp --dport "$PORT" -s "${ips[$i]}" -j RETURN; then
            err "插入 ${ips[$i]} 失败"
            return 1
        fi
    done

    log "apply port=$PORT n=${#ips[@]} entries=[${ips[*]}]"
    ok "已应用 ${#ips[@]} 条放行规则（端口 $PORT）"
}

# ---------------------------------------------------------------- 命令

cmd_list() {
    local n=0 ip

    printf '\n%s端口 %s 放行列表%s   %s\n' "$B$C" "$PORT" "$N" "$LIST"
    printf -- '---------------------------------------------\n'
    while IFS= read -r ip; do
        n=$((n+1))
        printf '  %s%2d)%s %s\n' "$C" "$n" "$N" "$ip"
    done < <(entries)
    if [ "$n" -eq 0 ]; then
        printf '  %s(空 —— 端口对所有来源开放，按 1 添加回源地址)%s\n' "$Y" "$N"
    fi
    printf -- '---------------------------------------------\n'
    printf '  共 %d 条\n' "$n"

    printf '\n%s当前 DOCKER-USER 生效规则%s\n' "$B$C" "$N"
    if chain_ok; then
        local got
        got=$(my_rules)
        if [ -z "$got" ]; then
            printf '  (无)\n'
        else
            printf '%s\n' "$got" | sed 's/^-A DOCKER-USER/  &/; s/^  -A/  -A/'
        fi
    else
        printf '  DOCKER-USER 链不存在\n'
    fi

    printf '\n%s命中计数%s\n' "$B$C" "$N"
    if chain_ok; then
        local cnt
        cnt=$(iptables -vnL "$CHAIN" 2>/dev/null | grep -E -- "dpt:${PORT}([[:space:]]|$)" || true)
        if [ -z "$cnt" ]; then
            printf '  (无)\n'
        else
            printf '%s\n' "$cnt" | sed 's/^/  /'
        fi
    fi
    printf '\n'
}

backup_list() {
    cp -f "$LIST" "$LIST.bak.$(date +%Y%m%d_%H%M%S)" 2>/dev/null || true
    ls -1t "$LIST".bak.* 2>/dev/null | tail -n +21 | xargs -r rm -f
}

cmd_add() {
    local v="${1:-}"
    [ -z "$v" ] && { err "用法: xboard-allowlist add <IP 或 CIDR>"; return 1; }
    valid_addr "$v" || { err "格式不对: $v   例: 1.2.3.4 或 1.2.3.0/24"; return 1; }
    if entries | grep -qxF "$v"; then
        warn "已存在: $v"
        return 0
    fi
    backup_list
    printf '%s\n' "$v" >> "$LIST"
    log "add $v"
    ok "已添加: $v"
    apply_rules
}

cmd_del() {
    local arg="${1:-}" target="" tmp
    [ -z "$arg" ] && { err "用法: xboard-allowlist del <序号 或 IP>"; return 1; }

    if entries | grep -qxF "$arg"; then
        target="$arg"
    elif [[ "$arg" =~ ^[0-9]+$ ]]; then
        target=$(entries | sed -n "${arg}p")
        [ -z "$target" ] && { err "序号 $arg 不存在（共 $(entries | wc -l) 条）"; return 1; }
    else
        err "未找到: $arg"
        return 1
    fi

    backup_list
    tmp=$(mktemp)
    grep -vxF "$target" "$LIST" > "$tmp" || true
    cat "$tmp" > "$LIST"
    rm -f "$tmp"
    chmod 640 "$LIST"
    log "del $target"
    ok "已删除: $target"
    apply_rules
}

cmd_test() {
    local code
    printf '本机 127.0.0.1:%s -> ' "$PORT"
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 \
        "http://127.0.0.1:${PORT}/api/v1/guest/comm/config" 2>/dev/null || echo 000)
    printf '%s\n' "$code"
    printf '（200 = 源站本身正常；外部能否访问取决于上面的放行列表）\n'
}

cmd_menu() {
    local ch v t
    while :; do
        clear 2>/dev/null || true
        printf '\n%s  XBoard 回源放行管理%s    端口 %s    后端链 %s（非 ufw）\n' \
            "$B$C" "$N" "$PORT" "$CHAIN"
        cmd_list
        cat <<EOM
  ${C}1${N}) 添加 IP / 网段
  ${C}2${N}) 删除 IP（输入序号或地址）
  ${C}3${N}) 重新应用规则
  ${C}4${N}) 本机连通性自测
  ${C}5${N}) 手工编辑列表
  ${C}0${N}) 退出

EOM
        printf '选择 [0-5]: '
        read -r ch || break
        case "$ch" in
            1)
                printf '输入 IP 或 CIDR: '
                read -r v || true
                cmd_add "$v"
                ;;
            2)
                printf '输入序号或 IP: '
                read -r v || true
                cmd_del "$v"
                ;;
            3)
                apply_rules
                ;;
            4)
                cmd_test
                ;;
            5)
                "${EDITOR:-vi}" "$LIST"
                printf '\n是否立即应用？[y/N] '
                read -r t || true
                case "$t" in y|Y) apply_rules ;; esac
                ;;
            0|q|exit)
                break
                ;;
            *)
                warn "无效选择：$ch"
                ;;
        esac
        printf '\n按回车继续...'
        read -r _ || true
    done
}

# ---------------------------------------------------------------- 入口

need_root
init_list

exec 9>"$DIR/.lock" 2>/dev/null || true
flock -n 9 2>/dev/null || { err "另一个实例正在运行"; exit 1; }

case "${1:-}" in
    list|ls)      cmd_list ;;
    add)          shift; cmd_add "${1:-}" ;;
    del|rm|remove) shift; cmd_del "${1:-}" ;;
    apply)        apply_rules ;;
    test)         cmd_test ;;
    raw)          iptables -vnL "$CHAIN" 2>/dev/null | grep -E -- "dpt:${PORT}([[:space:]]|$)" || true ;;
    help|-h|--help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//' ;;
    "")
        # 通过 `curl ... | bash` 运行时 stdin 是管道，read 会立刻 EOF；
        # 切到控制终端即可正常按数字操作。
        if [ ! -t 0 ] && [ -r /dev/tty ]; then
            exec < /dev/tty
        fi
        cmd_menu
        ;;
    *)            err "未知命令: $1"; printf '试试: %s help\n' "$0"; exit 1 ;;
esac
